  "id": "be_national_2007",
  "title": "Belarusian — national system 2000/2007 (with diacritics)",
  "language": "be",
  "script": "Cyrl",
  "kind": "official",
  "status": "superseded",
  "year": 2007,
  "authority": "State Committee on Land Resources, Geodesy and Cartography, Resolution No. 15 of 23.11.2000, as amended by State Property Committee Resolutions No. 12 (24.07.2006) and No. 38 (11.06.2007); repealed 2023",
  "description": "Belarusian national romanization of 2000 (amended 2006 and 2007), used for geographic names until 2023 and recommended by UNGEGN: Г→H, Ж→Ž, Х→CH, Ц→C, Ч→Č, Ш→Š, Ў→Ŭ, soft sign as an acute on the consonant (ź ĺ ń ś ć), Е Ё Ю Я → JE JO JU JA / IE IO IU IA by context.",
  "sources": [
    "http://www.pravo.by/pdf/2007-159/2007-159(027-028).pdf",
    "https://en.wikipedia.org/wiki/Romanization_of_Belarusian",
    "https://github.com/interscript/maps/blob/main/maps/by-bel-Cyrl-Latn-2007.isc",
    "https://unstats.un.org/unsd/geoinfo/UNGEGN/docs/20th-gegn-docs/20th_gegn_WP34.pdf"
  ],
  "notes": [
    "Samples are the examples of the 2007 amendment as transcribed by the interscript project (pravo.by 2007-159), written here with Cyrillic і instead of the Latin i found in some sources.",
    "2000 version: Ь → ʼ instead of the acute, Ў → ú (Homiel', Liuban'); 2007 replaced these with the acute and ŭ.",
    "The acute is written for every Ь after З Л Н С Ц (ДЗЬ → dź), including a separating Ь before Е Ё Ю Я, which also triggers the J-form (Вільянава → Viĺjanava). No official example shows a separating Ь, so that combination is an inference.",
    "Repealed by the 2023 Instruction (be_instruction_2023)."
  ],
  "alphabet": "абвгдеёжзійклмнопрстуўфхцчшыьэюя",
  "classes": {
    "V": "аеёіоуыэюя", "L": "абвгдеёжзійклмнопрстуўфхцчшыьэюя"
  },
  "aliases": {
    "’": "'", "ʼ": "'", "‘": "'", "`": "'", "´": "'"
  },
  "map": {
    "а": "a", "б": "b", "в": "v", "г": "h", "д": "d", "е": "ie", "ё": "io", "ж": "ž",
    "з": "z", "і": "i", "й": "j", "к": "k", "л": "l", "м": "m", "н": "n", "о": "o",
    "п": "p", "р": "r", "с": "s", "т": "t", "у": "u", "ў": "ŭ", "ф": "f", "х": "ch",
    "ц": "c", "ч": "č", "ш": "š", "ы": "y", "ь": "", "э": "e", "ю": "iu", "я": "ia",
    "зь": "ź", "ль": "ĺ", "нь": "ń", "сь": "ś", "ць": "ć"
  },
  "rules": [
    {"from": "е", "to": "je", "after": "^{V}ўь'"},
    {"from": "ё", "to": "jo", "after": "^{V}ўь'"},
    {"from": "ю", "to": "ju", "after": "^{V}ўь'"},
    {"from": "я", "to": "ja", "after": "^{V}ўь'"},
    {"from": "і", "to": "ji", "after": "'", "note": "apostrophe + і → ji"},
    {"from": "'", "to": "", "after": "{L}", "before": "{L}", "note": "apostrophe between letters"}
  ],
