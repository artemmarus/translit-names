{
  "id": "ar_buckwalter",
  "title": "Arabic — Buckwalter transliteration (ASCII, reversible)",
  "language": "ar",
  "script": "Arab",
  "kind": "ascii",
  "status": "current",
  "year": 1988,
  "reversible": true,
  "authority": "Tim Buckwalter (ALPNET 1988, Xerox); used by the Penn Arabic Treebank, BAMA/SAMA and CAMeL Tools",
  "description": "Strict one-to-one ASCII transliteration of Arabic letters and diacritics, used in computational linguistics; case-sensitive (H = ح, h = ه), harakat and shadda kept as a, u, i, o, ~, tanwīn as F, N, K. No vocalisation is added: the input is transliterated literally.",
  "sources": [
    "https://en.wikipedia.org/wiki/Buckwalter_transliteration",
    "https://camel-tools.readthedocs.io/en/latest/reference/encoding_schemes.html",
    "https://itftennis.atlassian.net/wiki/download/attachments/1272938619/Passport%20Standards.pdf?api=v2"
  ],
  "notes": [
    "Shadda (~) is written right after its consonant, before the vowel mark (muHam~ad), as in the Penn Arabic Treebank.",
    "Extended letters پ P, چ J, ڤ V, گ G as in CAMeL Tools. Persian/Urdu letter shapes (ی ک ہ ھ ے ۃ) are folded to their Arabic counterparts before transliteration; other non-Arabic letters are kept unchanged, so the output is ASCII only for Arabic text.",
    "XML-safe variants (Safe-BW, XML-BW) are not provided."
  ],
  "alphabet": "ءآأؤإئابةتثجحخدذرزسشصضطظعغفقكلمنهوىيٱپچڤگ",
  "hook": "arabic",
  "options": {"lexicon": false},
  "geminate": "\u0651",
  "titlecase": false,
  "case": "preserve",
  "aliases": {"ی": "ي", "ک": "ك", "ڪ": "ك", "ہ": "ه", "ھ": "ه", "ۀ": "ه", "ە": "ه", "ۃ": "ة", "ې": "ي", "ے": "ي"},
