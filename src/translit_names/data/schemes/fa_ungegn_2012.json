  "lowercase_words": ["e", "ye", "ol", "ot", "os", "od", "oz", "or", "oš", "on", "ož"],
  "aliases": {"ي": "ی", "ى": "ی", "ك": "ک", "ہ": "ه", "ھ": "ه", "ە": "ه", "ۂ": "ۀ"},
