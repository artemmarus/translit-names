  "authority": "State Property Committee of Belarus, Resolution No. 19 of 24.03.2023 (reg. 8/39778), Instruction, Appendix 1",
  "description": "Official Belarusian romanization for geographic names (State Property Committee Resolution No. 19 of 24.03.2023), without diacritics: Г→G, Ж→ZH, Х→H, Ц→C, Ч→CH, Ш→SH, Й→J, Ў→W; Е Ё Ю Я → JE JO JU JA word-initially, after vowels, Ў, apostrophe and separating Ь, IE IO IU IA after consonants; Ь and apostrophe not written.",
  "sources": [
    "https://pravo.by/upload/docs/op/W22339778_1680555600.pdf",
    "https://pravo.by/document/?guid=12551&p0=W22339778&p1=1&p5=0",
    "https://en.wikipedia.org/wiki/Romanization_of_Belarusian",
    "https://yandex.ru/support/nmaps/app_transliteration.html"
  ],
  "notes": [
    "All official examples of Appendix 1 are included as samples; the national-name examples (Беларусь, Лукашэнка, Магілёў, сям’я) are from Wikipedia.",
    "Appendix 2 of the same Instruction (Russian-language names in Belarus: Е→E always, Ё→JO, Ю→JU, Я→JA, Ъ/separating Ь → J) is not encoded here.",
    "The Instruction is for geographic names; personal names in passports follow other practice (see be_passport, be_mvd_288)."
  ],
  "alphabet": "абвгдеёжзійклмнопрстуўфхцчшыьэюя",
  "classes": {
    "V": "аеёіоуыэюя", "L": "абвгдеёжзійклмнопрстуўфхцчшыьэюя"
  },
  "aliases": {
    "’": "'", "ʼ": "'", "‘": "'", "`": "'", "´": "'"
  },
  "map": {
    "а": "a", "б": "b", "в": "v", "г": "g", "д": "d", "е": "ie", "ё": "io", "ж": "zh",
    "з": "z", "і": "i", "й": "j", "к": "k", "л": "l", "м": "m", "н": "n", "о": "o",
    "п": "p", "р": "r", "с": "s", "т": "t", "у": "u", "ў": "w", "ф": "f", "х": "h",
    "ц": "c", "ч": "ch", "ш": "sh", "ы": "y", "ь": "", "э": "e", "ю": "iu", "я": "ia"
  },
  "rules": [
    {"from": "е", "to": "je", "after": "^{V}ўь'"},
    {"from": "ё", "to": "jo", "after": "^{V}ўь'"},
    {"from": "ю", "to": "ju", "after": "^{V}ўь'"},
    {"from": "я", "to": "ja", "after": "^{V}ўь'"},
    {"from": "і", "to": "ji", "after": "'", "note": "apostrophe + і → ji (Мар’іна → Marjina)"},
    {"from": "'", "to": "", "after": "{L}", "before": "{L}", "note": "apostrophe between letters"}
  ],
