    "ء": "", "أ": "", "إ": "", "ؤ": "", "ئ": "", "آ": "a", "ا": "a", "ٱ": "", "ى": "a", "ة": "a",
    "\u064e": "a", "\u064f": "u", "\u0650": "i", "\u0652": "", "\u064b": "", "\u064c": "", "\u064d": "",
    "\u0670": "a", "ـ": "", "\u0654": "", "\u0655": "", "\u0653": "", "\u200c": "", "\u064eا": "a",
    "\u064eى": "a", "\u064eى\u0670": "a", "ى\u0670": "a", "\u064e\u0670": "a", "\u0650ى": "i",
    "\u0650ي\u0651": "iyy", "\u064fو\u0651": "uww", "\u064eة": "a", "ع\u0651": "", "ث\u0651": "th",
    "خ\u0651": "kh", "ذ\u0651": "dh", "ش\u0651": "sh", "غ\u0651": "gh"
  },
